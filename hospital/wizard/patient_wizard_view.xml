<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_patient_wizard_form" model="ir.ui.view">
        <field name="name">patient.wizard.form</field>
        <field name="model">patient.wizard</field>
        <field name="arch" type="xml">
            <form string="patient">
                <group>
                    <field name="patient_id"/>
                </group>
                <footer>
                    <button name="action_print_excel" type="object" string="print Excel" class="btn-secondary" />
                    <button name="action_cancel" string="Cancel " special="cancel" type="object" class="btn-danger"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_patient_wizard_view" model="ir.actions.act_window">
        <field name="name">patient.wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">patient.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field> </record>

    <menuitem id="menu_patient_wizard_view"
              name="get report excel patient"
              parent="menu_patient_appointment"
              action="action_patient_wizard_view"
              sequence="30"/>
</odoo>